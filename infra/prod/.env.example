# Copy to repo root as .env.prod and fill in real values:
#   cp infra/prod/.env.example .env.prod
# Never commit .env.prod.

ENV=production
TENANT_ID=default
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
UVICORN_WORKERS=1
ENABLE_DOCS=false

# Browser origins allowed to call the API (your Vercel URL(s) — no wildcards).
# Include preview URLs if needed, comma-separated.
CORS_ORIGINS=https://YOUR_PROJECT.vercel.app,https://YOUR_CUSTOM_DOMAIN.com

# Postgres (compose service name = host)
POSTGRES_USER=floodtail
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=floodtail
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ollama (internal compose network)
OLLAMA_HOST=http://ollama:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIM=768
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_FORCE_MEMORY=false

# JWT / Keycloak (keep secrets strong even if Keycloak is deferred)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=floodtail
KEYCLOAK_CLIENT_ID=floodtail-api
KEYCLOAK_CLIENT_SECRET=REPLACE_ME
JWT_SECRET=REPLACE_WITH_32+_CHAR_RANDOM
JWT_ALGORITHM=HS256
# Align with SESSION_IDLE_MINUTES (sliding JWT while user is active)
JWT_EXP_MINUTES=10

# Gate login — required or /v1/auth/token returns 503
LOGIN_EMAIL=kenyarefloodtail@gmail.com
LOGIN_PASSWORD="jcdguey3546276evhx.,"
SESSION_IDLE_MINUTES=10

# 32-byte key as base64 (generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())")
AES_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTES

# Modelling
D_MAX_M=4.0
RETURN_PERIODS=5,20,50,100,250
ASSUMPTIONS_VERSION=nairobi-pluvial-v1
MAX_UPLOAD_MB=50

CAPITAL_FLOOR_RP=100
CAPITAL_CEILING_RP=250
CAPITAL_CEILING_TIV_FRACTION=1.0
CAPITAL_CURRENCY=KES

REQUIRE_ML=true
ALLOW_PRIOR_ONLY=false

OVERPASS_URL=https://overpass-api.de/api/interpreter
USE_OSM_DEFAULT=false
HOTSPOTS_FILENAME=nairobi_hotspots_geocoded.csv
