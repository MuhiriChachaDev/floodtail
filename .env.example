# General
ENV=prototype
TENANT_ID=default
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Postgres (compose)
POSTGRES_USER=floodtail
POSTGRES_PASSWORD=floodtail_dev_change_me
