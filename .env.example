# General
ENV=prototype
TENANT_ID=default
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Postgres (compose)
POSTGRES_USER=floodtail
POSTGRES_PASSWORD=floodtail_dev_change_me
POSTGRES_DB=floodtail
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ollama (start with: bash scripts/ensure_ollama.sh)
OLLAMA_HOST=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:3b-instruct
# Optional local dirs if ~/.ollama is not writable:
# FLOODTAIL_OLLAMA_HOME=.ollama-home
# OLLAMA_MODELS=.ollama-models

# Keycloak / JWT
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=floodtail
KEYCLOAK_CLIENT_ID=floodtail-api
KEYCLOAK_CLIENT_SECRET=change_me
JWT_SECRET=dev_jwt_secret_change_me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=15

# Security
AES_KEY_BASE64=Zm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFy

# Modelling defaults
D_MAX_M=4.0
RETURN_PERIODS=5,20,50,100,250
ASSUMPTIONS_VERSION=nairobi-pluvial-v1
MAX_UPLOAD_MB=50

# Capital / set-aside band (underwriter guidance)
CAPITAL_FLOOR_RP=100
CAPITAL_CEILING_RP=250
CAPITAL_CEILING_TIV_FRACTION=1.0
CAPITAL_CURRENCY=KES

# Predictive ML is required for product runs (train + pin models first)
REQUIRE_ML=true
# Set true only for tests / offline prior-only debugging
ALLOW_PRIOR_ONLY=false

# Optional OSM Overpass enrichment (off by default — Overpass is flaky; runs never depend on it)
OVERPASS_URL=https://overpass-api.de/api/interpreter
USE_OSM_DEFAULT=false
HOTSPOTS_FILENAME=nairobi_hotspots_geocoded.csv
